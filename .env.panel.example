# EVENTIDE OMEGA — PANEL ENVIRONMENT TEMPLATE
# Copy this file to `.env`, fill any values you need, then restart the panel.
# Never commit a real .env containing tokens or API keys.

# Required: permit WhatsApp sockets outside Render.
PANEL_BOT_ENABLED=true

# Required on a panel: use persistent local disk, not Supabase.
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_KEY=

# Git updates on panel restart and through .gitpull.
AUTO_UPDATE=true
GIT_REMOTE_URL=https://github.com/Phantom-Dev-X/eventide-omega-bug-test.git

# Leave PORT empty if the panel injects SERVER_PORT. Otherwise set the allocated port.
PORT=
MAX_USERS=10
VERBOSE_LOGS=false

# Optional Telegram pairing/admin bot.
TELEGRAM_TOKEN=
DEV_TELEGRAM_IDS=
TELEGRAM_BACKUP_CHANNEL=

# WhatsApp owner/developer numbers: digits only, comma-separated, no + sign.
DEV_NUMBERS=

# Optional AI providers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=

# Free clean web address: WEB_TUNNEL=cloudflare gives https://…trycloudflare.com
# (no port, IP hidden, HTTPS). New URL is DM'd to the owner on WhatsApp.
WEB_TUNNEL=
# Permanent address instead of the rotating one: put a Cloudflare named-tunnel
# token here (requires your own domain on Cloudflare) - https://yourdomain.com
CLOUDFLARE_TUNNEL_TOKEN=

# Optional website and channel settings.
GROUP_CHANNEL_LINK=
ALLOWED_ORIGINS=

# Local backup schedule.
BACKUP_EVERY_MIN=360
BACKUP_KEEP=7

# Reconnection tuning.
CLOSE428_DELAY_MS=15000
CLOSE428_STORM_BACKOFF_MS=60000

# Persistent panel data (do not delete during updates):
#   sessions/
#   backups/
#   web_users.json
#   web_id_sessions.json
#   user_map.json
